    {
      "name": "2 - Publicaciones",
      "item": [
        {
          "name": "Listar (por fecha, por defecto) - 200",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "pm.test('Tiene items, total, offset y limit', () => pm.expect(r).to.have.all.keys('items', 'total', 'offset', 'limit'));",
                  "pm.test('Ordenado por fecha descendente', () => { const f = r.items.map(i => new Date(i.createdAt)); pm.expect(f.every((d, i) => i === 0 || f[i - 1] >= d)).to.be.true; });",
                  "if (r.items.length) pm.collectionVariables.set('publicacionId', r.items[0].id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/publicaciones",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "publicaciones"
              ]
            },
            "description": "También guarda el id de la primera publicación en {{publicacionId}} para las pruebas de me gusta y eliminar."
          }
        },
