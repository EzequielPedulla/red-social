                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const l = pm.response.json().items.map(i => i.cantidadLikes);",
                  "pm.test('Ordenado por cantidad de me gusta', () => pm.expect(l.every((n, i) => i === 0 || l[i - 1] >= n)).to.be.true);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
